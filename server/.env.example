# Traffic Assist Backend Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/traffic_assist
DB_HOST=localhost
DB_PORT=5432
DB_NAME=traffic_assist
DB_USER=traffic_assist_user
DB_PASSWORD=your_secure_password
DB_SSL=false

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_REGION=us-central1

# Google Cloud SQL (Production)
CLOUD_SQL_CONNECTION_NAME=your-project:region:instance
CLOUD_SQL_DATABASE_URL=postgresql://user:password@/traffic_assist?host=/cloudsql/your-project:region:instance

# Google Pub/Sub
PUBSUB_TRAFFIC_EVENTS_TOPIC=traffic-events
PUBSUB_TRAFFIC_UPDATES_TOPIC=traffic-updates
PUBSUB_ALERTS_TOPIC=alerts

# Google Cloud Storage
GCS_BUCKET_NAME=traffic-assist-data
GCS_MODELS_BUCKET=traffic-assist-models

# Security Configuration
JWT_SECRET=your-very-secure-jwt-secret-key-change-this-in-production
CORS_ORIGIN=http://localhost:3000,https://your-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket Configuration
WEBSOCKET_HEARTBEAT_INTERVAL=30000
WEBSOCKET_TIMEOUT=60000

# Monitoring and Analytics
ENABLE_ANALYTICS=true
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL=60000

# Development/Testing
ENABLE_SAMPLE_DATA=false
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# Performance Configuration
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Geospatial Configuration
DEFAULT_SEARCH_RADIUS=1000
MAX_SEARCH_RADIUS=10000
LOCATION_GRID_SIZE=0.001

# Caching (if using Redis)
REDIS_URL=redis://localhost:6379
CACHE_TTL=300

# External Services
MAPS_API_KEY=your-maps-api-key
PUSH_NOTIFICATION_KEY=your-push-notification-key

# Backup and Maintenance
BACKUP_SCHEDULE=0 2 * * *
CLEANUP_OLD_DATA_DAYS=30
ENABLE_AUTO_CLEANUP=true
