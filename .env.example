# Environment Configuration
REACT_APP_API_URL=https://traffic-assist-api-xxx.run.app
REACT_APP_WS_URL=wss://traffic-assist-ws-xxx.run.app
REACT_APP_VAPID_PUBLIC_KEY=your_vapid_public_key

# Database
DATABASE_URL=postgresql://app_user:secure_password@/traffic_assist?host=/cloudsql/YOUR_PROJECT:us-central1:traffic-assist-db

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# APIs
OPENAI_API_KEY=your_openai_key_for_ai_processing
MAPS_API_KEY=your_google_maps_key
